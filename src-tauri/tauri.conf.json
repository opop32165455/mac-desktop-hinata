{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Purple Moment",
  "version": "1.0.0",
  "identifier": "com.purplemoment.desktop",
  "build": {
    "frontendDist": "../build/app-frontend",
    "beforeBuildCommand": "bash tools/app-stage.sh",
    "beforeDevCommand": "bash tools/app-stage.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/media/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "resources": {
      "../media/": "media/"
    }
  }
}
